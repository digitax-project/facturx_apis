{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitax.example/schemas/phase1-control-report-1.1.0.json",
  "title": "DigiTax Phase 1 control report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "runId", "sourceSha256", "catalogVersion", "controlProfileId", "controlProfileVersion", "status", "routing", "controls", "startedAt", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "reportId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._:-]{1,200}$"
    },
    "sourceSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "controlProfileId": { "type": "string", "minLength": 1 },
    "controlProfileVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["unauffaellig", "hinweis", "klaerung_erforderlich", "nicht_pruefbar"] },
    "routing": { "enum": ["standard_review", "prioritized_review"] },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controlId", "title", "outcome", "severity", "reasonCodes", "evidenceRefs", "ruleVersion"],
        "properties": {
          "controlId": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "outcome": { "enum": ["passed", "failed", "not_run", "not_applicable", "not_reliable"] },
          "severity": { "enum": ["none", "info", "warning", "blocking", "technical"] },
          "reasonCodes": { "type": "array", "items": { "type": "string" } },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } },
          "ruleVersion": { "type": "string", "minLength": 1 },
          "message": { "type": ["string", "null"] },
          "details": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "formula": { "type": ["string", "null"] },
              "expected": {},
              "actual": {},
              "difference": { "type": ["number", "null"] },
              "tolerance": { "type": ["number", "null"] },
              "mismatches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["field", "expected", "actual"],
                  "properties": {
                    "field": { "type": "string" },
                    "expected": {},
                    "actual": {}
                  }
                }
              },
              "schematronFindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ruleId", "message"],
                  "properties": {
                    "ruleId": { "type": "string", "minLength": 1 },
                    "flag": { "type": ["string", "null"] },
                    "message": { "type": "string" },
                    "location": { "type": ["string", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "suggestions": { "type": "array", "items": { "type": "string" }, "default": [] },
    "reqeli": {
      "type": "object",
      "deprecated": true,
      "$comment": "DEPRECATED as of schema 1.1.0 (recorded, not removed/renamed, per the A1 P2.1 review: a versioned schema must not silently change shape). The canonical service is DigiTax Risk Review, a separate advisory output produced after this deterministic report (see docs/invoice_phase1/README.md and coordination/control-plane/runs/2026-08-25-vnimpex-pilot-integration/data-model.md's RiskReviewReport), not part of this report. This field is kept only for backward compatibility with existing consumers and always carries {invoked: false, status: 'disabled', analysisRef: null} -- no reqeli/legacy analysis is invoked by this codebase. It will be removed or migrated in the next explicitly versioned (2.x) contract change, not silently in a 1.x patch.",
      "additionalProperties": false,
      "required": ["invoked", "status"],
      "properties": {
        "invoked": { "type": "boolean" },
        "status": { "enum": ["not_required", "disabled", "completed", "failed"] },
        "analysisRef": { "type": ["string", "null"] }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
