    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst statusCode = response.statusCode || 503;\nconst body = response.body || {};\nif (statusCode >= 200 && statusCode < 300 && body.phase1ControlReport) {\n  return [{ json: { ok: true, statusCode, canonicalInvoice: body.canonicalInvoice, phase1ControlReport: body.phase1ControlReport } }];\n}\nconst detail = body.detail && typeof body.detail === 'object' ? body.detail : {};\nreturn [{ json: { ok: false, statusCode, errorCode: detail.error_code || 'BATCH_ITEM_PROCESSING_FAILED', detail: detail.detail || response.message || 'Invoice processing failed.' } }];"
      },
