{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitax.de/schemas/execution-evidence/1.0/human-review-decision.json",
  "title": "DigiTax HumanReviewDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "reviewEventId", "reviewedExecutionId", "correlationId",
    "scope", "reviewerRole", "reviewerId", "decision", "reasonCode",
    "rationale", "createdAt", "evidenceRefs", "supersedesReviewEventId"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "reviewEventId": { "type": "string", "minLength": 1 },
    "reviewedExecutionId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["CONTROL_FINDING", "PROCESS_STEP", "FINAL_PROCESS_DECISION"] },
    "reviewerRole": { "type": "string", "minLength": 1 },
    "reviewerId": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["APPROVE", "MODIFY", "REJECT", "ESCALATE"] },
    "reasonCode": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "maxLength": 1000 },
    "createdAt": { "type": "string", "format": "date-time" },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "supersedesReviewEventId": { "type": ["string", "null"] }
  }
}
